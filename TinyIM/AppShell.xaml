<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TinyIM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TinyIM.Views"
    Title="TinyIM">

    <TabBar>
        <ShellContent
            Title="信息"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:MessagesPage}"
            Route="MessagesPage" />

        <ShellContent
            Title="应用"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:ApplicationsPage}"
            Route="ApplicationsPage" />

        <ShellContent
            Title="设置"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
