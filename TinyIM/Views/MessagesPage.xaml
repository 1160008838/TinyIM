<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TinyIM.ViewModels"
             x:Class="TinyIM.Views.MessagesPage"
             Title="信息">

    <ContentPage.BindingContext>
        <local:MessagesViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" Padding="10">
        <!-- Header -->
        <Label Grid.Row="0" 
               Text="局域网设备列表" 
               FontSize="20" 
               FontAttributes="Bold"
               Margin="0,10,0,20"
               HorizontalOptions="Center"/>

        <!-- Device List -->
        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding Devices}"
                       SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" 
                          ColumnDefinitions="60,*,Auto" 
                          RowDefinitions="Auto,Auto"
                          Margin="5">
                        
                        <!-- Avatar -->
                        <Border Grid.Column="0" 
                               Grid.RowSpan="2"
                               StrokeShape="RoundRectangle 30"
                               Stroke="LightGray"
                               StrokeThickness="1"
                               HeightRequest="60"
                               WidthRequest="60"
                               Margin="0,0,10,0">
                            <Image Source="{Binding Avatar}" 
                                  Aspect="AspectFill"/>
                        </Border>

                        <!-- Device Name -->
                        <Label Grid.Column="1" 
                              Grid.Row="0"
                              Text="{Binding Name}"
                              FontSize="16"
                              FontAttributes="Bold"
                              VerticalOptions="End"/>

                        <!-- Platform and IP -->
                        <HorizontalStackLayout Grid.Column="1" 
                                              Grid.Row="1"
                                              Spacing="10"
                                              VerticalOptions="Start">
                            <Label Text="{Binding Platform}"
                                  FontSize="12"
                                  TextColor="Gray"/>
                            <Label Text="|"
                                  FontSize="12"
                                  TextColor="Gray"/>
                            <Label Text="{Binding IpAddress}"
                                  FontSize="12"
                                  TextColor="Gray"/>
                        </HorizontalStackLayout>

                        <!-- Online Status -->
                        <Label Grid.Column="2" 
                              Grid.RowSpan="2"
                              Text="●"
                              FontSize="20"
                              TextColor="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}"
                              VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
